@namespace BlazorLab.Web.Components.Shared

<div class="card mb-3">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">@Titulo</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Descricao))
        {
            <p class="text-muted">@Descricao</p>
        }
        
        <div class="demo-area border p-3 mb-3">
            @ChildContent
        </div>

        @if (MostrarPontoChave)
        {
            <div class="alert alert-light">
                <strong>📌 Pontos-chave:</strong>
                <div>@PontoChave</div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Titulo { get; set; } = "Demo";

    [Parameter]
    public string? Descricao { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? PontoChave { get; set; }

    [Parameter]
    public bool MostrarPontoChave { get; set; } = true;
}
